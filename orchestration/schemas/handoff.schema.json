{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookShelf role handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "role", "status", "previous_handoff", "summary", "context", "plan", "rationale", "approval", "changed_files", "tests", "remarks", "guardrails", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "task_id": {"type": "string"},
    "role": {"type": "string", "enum": ["Planner", "Coder", "Reviewer"]},
    "status": {"type": "string", "enum": ["ready_for_approval", "ready_for_review", "pass", "changes_required", "blocked"]},
    "previous_handoff": {"type": "string"},
    "summary": {"type": "string"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "sources", "assumptions"],
      "properties": {
        "baseline": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["reference", "access", "result"],
          "properties": {
            "reference": {"type": "string"},
            "access": {"type": "string", "enum": ["local", "mcp"]},
            "result": {"type": "string"}
          }
        }},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["steps", "allowed_files", "acceptance_criteria", "test_plan"],
      "properties": {
        "steps": {"type": "array", "items": {"type": "string"}},
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "test_plan": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rationale": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "approved_files"],
      "properties": {
        "reference": {"type": "string"},
        "approved_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "changed_files": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "change", "reason"],
      "properties": {
        "path": {"type": "string"},
        "change": {"type": "string", "enum": ["added", "modified", "deleted"]},
        "reason": {"type": "string"}
      }
    }},
    "tests": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["reported_by", "command", "status", "exit_code", "result"],
      "properties": {
        "reported_by": {"type": "string", "enum": ["Planner", "Coder", "Reviewer"]},
        "command": {"type": "string"},
        "status": {"type": "string", "enum": ["passed", "failed", "not_run"]},
        "exit_code": {"type": ["integer", "null"]},
        "result": {"type": "string"}
      }
    }},
    "remarks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "priority", "evidence", "recommendation", "state"],
      "properties": {
        "id": {"type": "string"},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "evidence": {"type": "string"},
        "recommendation": {"type": "string"},
        "state": {"type": "string", "enum": ["open", "resolved"]}
      }
    }},
    "guardrails": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "assessment", "evidence"],
      "properties": {
        "rule": {"type": "string"},
        "assessment": {"type": "string", "enum": ["compliant", "violation", "not_applicable", "unverified"]},
        "evidence": {"type": "string"}
      }
    }},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
